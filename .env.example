# Neon Postgres connection string (required)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Vercel Blob (auto-set when the store is linked; or paste BLOB_READ_WRITE_TOKEN)
# On Vercel, OIDC + BLOB_STORE_ID is enough for server uploads.
BLOB_READ_WRITE_TOKEN=
# Optional legacy flag (uploads no longer depend on this)
NEXT_PUBLIC_USE_BLOB=false

# OpenAI API key for AI ski resort summaries + booking import
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
