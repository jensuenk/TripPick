# Neon Postgres connection string (required)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Vercel Blob token (optional locally — without it, photos upload to /public/uploads)
# When set in production, also set NEXT_PUBLIC_USE_BLOB=true
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_USE_BLOB=false

# OpenAI API key for AI ski resort summaries in destination detail
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
